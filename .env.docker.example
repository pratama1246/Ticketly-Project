#--------------------------------------------------------------------
# Environment Configuration for Docker Deployment (Example Template)
# Copy this file to .env.docker and adjust your secret keys.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = ticketly
database.default.username = ticketly_user
database.default.password = ticketly_password
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION & JWT AUTHENTICATION
#--------------------------------------------------------------------
JWT_SECRET_KEY = your_jwt_secret_key_here

#--------------------------------------------------------------------
# COOKIE & SESSION
#--------------------------------------------------------------------
cookie.secure = false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# EMAIL (SMTP / MAILTRAP CONFIGURATION)
#--------------------------------------------------------------------
email.fromName    = 'Ticketly System'
email.fromEmail   = 'noreply@ticketly.mytamakikii.web.id'
email.protocol    = 'smtp'
email.SMTPHost    = 'live.smtp.mailtrap.io'
email.SMTPUser    = 'api'
email.SMTPPass    = 'your_smtp_password_here'
email.SMTPPort    = 2525
email.SMTPCrypto  = 'tls'
email.mailType    = 'html'

#--------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY (SANDBOX)
#--------------------------------------------------------------------
MIDTRANS_SERVER_KEY = SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY = SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION = false
MIDTRANS_NOTIFICATION_URL = ''
