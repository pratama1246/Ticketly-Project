{
  "openapi": "3.0.3",
  "info": {
    "title": "Ticketly API Documentation",
    "version": "1.2.0",
    "description": "Dokumentasi resmi REST API Ticketly untuk Flutter Mobile App & Web Integration. Semua respons sukses dan error mengikuti format baku `{ status, message, data }`."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Otentikasi, Registrasi, Logout & OTP Password Reset" },
    { "name": "Events", "description": "Katalog Event, Konser, Festival & Tiket" },
    { "name": "Profile", "description": "Manajemen Profil Akun & Data Pengguna" },
    { "name": "Checkout", "description": "Kalkulasi Biaya, Midtrans Direct Charge & Pemesanan Tiket" },
    { "name": "Orders", "description": "Riwayat Transaksi & E-Tiket (UU PDP Data Masking)" },
    { "name": "Vouchers", "description": "Sistem Voucher Diskon & Kupon Promo" },
    { "name": "Scanner", "description": "Gate Check-in Scanner API & Anti-Double Scan Protection" },
    { "name": "Payment", "description": "Midtrans Payment Webhook & Notification Handler" },
    { "name": "Legal", "description": "Syarat Ketentuan (T&C) & Kebijakan Privasi (Privacy Policy)" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Kirim JWT token pada header `Authorization: Bearer <token>`. Dapatkan token melalui `POST /api/auth/login`."
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string", "example": "Operasi berhasil." },
          "data": { "nullable": true, "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "message": { "type": "string", "example": "Pesan deskripsi error yang jelas." },
          "data": {
            "nullable": true,
            "oneOf": [
              { "type": "object", "additionalProperties": { "type": "string" }, "example": { "field_name": "Pesan error untuk field ini." } },
              { "type": "null" }
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Login Pengguna",
        "description": "Mengautentikasi pengguna dengan email & password, menghasilkan JWT token 7 hari.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "password": { "type": "string", "minLength": 6, "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login berhasil, token JWT dikembalikan." },
          "401": { "description": "Email atau password salah." },
          "422": { "description": "Validasi gagal." }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Registrasi Pengguna Baru",
        "description": "Mendaftarkan akun pengguna baru ke dalam sistem.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string", "example": "john_doe" },
                  "email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registrasi berhasil." },
          "422": { "description": "Validasi gagal (email / username sudah ada)." }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Logout Pengguna (JWT Blacklist Revocation)",
        "description": "Memasukkan token JWT ke dalam daftar blacklist cache sehingga token tidak dapat digunakan lagi.",
        "tags": ["Auth"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Logout berhasil dan token diblacklist." },
          "401": { "description": "Unauthorized / Token tidak valid." }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Forgot Password (Request OTP)",
        "description": "Mengirimkan kode OTP verifikasi 6-digit ke email terdaftar (disimpan dengan enkripsi Bcrypt).",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "user@example.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Kode OTP berhasil dikirim ke email." },
          "404": { "description": "Email tidak terdaftar." }
        }
      }
    },
    "/api/auth/verify-code": {
      "post": {
        "summary": "Verify OTP Code",
        "description": "Memverifikasi kecocokan kode OTP 6-digit.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "code": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Kode OTP valid." },
          "404": { "description": "Kode tidak valid atau salah." },
          "410": { "description": "Kode OTP telah kedaluwarsa." }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Reset Password dengan OTP",
        "description": "Mengganti kata sandi baru dan langsung menghapus OTP (Single-Use Enforcement).",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "code": { "type": "string", "example": "123456" },
                  "password": { "type": "string", "minLength": 8, "example": "newPassword123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password berhasil diubah." },
          "404": { "description": "Kode tidak valid." }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Daftar Event (Katalog)",
        "description": "Mengambil daftar event yang dipublikasikan dengan opsi filter kategori, search, dan pagination.",
        "tags": ["Events"],
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["concert", "festival", "event"] } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Daftar event berhasil diambil." }
        }
      }
    },
    "/api/events/featured": {
      "get": {
        "summary": "Event Pilihan (Featured)",
        "description": "Mengambil daftar event yang ditandai sebagai featured / highlight utama.",
        "tags": ["Events"],
        "responses": {
          "200": { "description": "Event featured berhasil diambil." }
        }
      }
    },
    "/api/events/landing": {
      "get": {
        "summary": "Data Landing Page Event",
        "description": "Mengambil data gabungan featured, concerts, festivals, dan upcoming events untuk home screen Flutter.",
        "tags": ["Events"],
        "responses": {
          "200": { "description": "Data landing page berhasil diambil." }
        }
      }
    },
    "/api/events/{slug}": {
      "get": {
        "summary": "Detail Event berdasarkan Slug",
        "description": "Mengambil informasi lengkap event, deskripsi, lokasi venue, poster, denah kursi, dan daftar tipe tiket.",
        "tags": ["Events"],
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Detail event berhasil diambil." },
          "404": { "description": "Event tidak ditemukan." }
        }
      }
    },
    "/api/events/{eventId}/tickets": {
      "get": {
        "summary": "Daftar Tipe Tiket per Event",
        "description": "Mengambil daftar tiket, sisa kuota, dan harga untuk suatu event.",
        "tags": ["Events"],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar tiket berhasil diambil." },
          "404": { "description": "Event tidak ditemukan." }
        }
      }
    },
    "/api/profile": {
      "get": {
        "summary": "Profil Pengguna",
        "description": "Mengambil profil pengguna yang sedang login.",
        "tags": ["Profile"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Data profil berhasil diambil." },
          "401": { "description": "Unauthorized." }
        }
      }
    },
    "/api/profile/update": {
      "post": {
        "summary": "Update Profil & Foto",
        "description": "Memperbarui username, email (sinkron ke auth_identities), password, dan foto profil.",
        "tags": ["Profile"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "foto": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profil berhasil diperbarui." },
          "422": { "description": "Validasi gagal." }
        }
      }
    },
    "/api/checkout/payment-methods": {
      "get": {
        "summary": "Daftar Metode Pembayaran Midtrans",
        "description": "Mengambil 10 metode pembayaran Direct Charge (BCA, BNI, BRI, Permata, Mandiri Bill, Gopay, ShopeePay, QRIS, Akulaku).",
        "tags": ["Checkout"],
        "responses": {
          "200": { "description": "Daftar metode pembayaran berhasil diambil." }
        }
      }
    },
    "/api/checkout/calculate": {
      "post": {
        "summary": "Kalkulasi Rincian Biaya & Diskon Voucher",
        "description": "Menghitung subtotal, pajak PPN 11%, platform fee, admin fee, dan potongan diskon voucher secara dinamis.",
        "tags": ["Checkout"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tickets"],
                "properties": {
                  "tickets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["ticket_type_id", "quantity"],
                      "properties": {
                        "ticket_type_id": { "type": "integer", "example": 1 },
                        "quantity": { "type": "integer", "example": 2 }
                      }
                    }
                  },
                  "voucher_code": { "type": "string", "example": "TIKETLYHEMAT20" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Kalkulasi rincian biaya berhasil." },
          "422": { "description": "Tiket tidak valid." }
        }
      }
    },
    "/api/checkout/start": {
      "post": {
        "summary": "Start Checkout (Midtrans Direct Charge, Voucher & Multi-Attendee)",
        "description": "Membuat pesanan dengan proteksi Idempotency Key, Anti-Scalper NIK Limit (max 4 tiket), Atomic Stock Reservation, Pessimistic Seat Locking, dan Direct Charge Midtrans.",
        "tags": ["Checkout"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "X-Idempotency-Key", "in": "header", "schema": { "type": "string", "format": "uuid" }, "description": "UUIDv4 Idempotency Key mencegah double charge." }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["first_name", "email", "phone_number", "identity_number", "payment_method", "tickets"],
                "properties": {
                  "first_name": { "type": "string", "example": "Budi" },
                  "last_name": { "type": "string", "example": "Santoso" },
                  "email": { "type": "string", "format": "email", "example": "budi@gmail.com" },
                  "phone_number": { "type": "string", "example": "081234567890" },
                  "identity_number": { "type": "string", "example": "3201234567890001" },
                  "birth_date": { "type": "string", "format": "date", "example": "1998-05-12" },
                  "payment_method": { "type": "string", "example": "bca_va" },
                  "voucher_code": { "type": "string", "example": "TIKETLYHEMAT20" },
                  "tickets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ticket_type_id": { "type": "integer", "example": 2 },
                        "quantity": { "type": "integer", "example": 2 }
                      }
                    }
                  },
                  "attendees": {
                    "type": "array",
                    "description": "Data pemegang tiket per lembar (Multi-Attendee Registration)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string", "example": "Budi Santoso" },
                        "email": { "type": "string", "example": "budi@gmail.com" },
                        "identity_number": { "type": "string", "example": "3201234567890001" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order berhasil dibuat dan payment charge Midtrans dikembalikan." },
          "409": { "description": "Stok habis / Kursi bentrok." },
          "422": { "description": "Batas kuota NIK terlampaui / Validasi gagal." }
        }
      }
    },
    "/api/checkout/confirm": {
      "post": {
        "summary": "Konfirmasi Pembayaran Order",
        "description": "Mengecek status asli pembayaran ke Midtrans Core API dan menerbitkan E-Tiket PDF.",
        "tags": ["Checkout"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_id"],
                "properties": {
                  "order_id": { "type": "integer", "example": 102 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pembayaran dikonfirmasi dan tiket diterbitkan." },
          "400": { "description": "Pembayaran belum terdeteksi." },
          "410": { "description": "Order telah kedaluwarsa." }
        }
      }
    },
    "/api/checkout/cancel": {
      "post": {
        "summary": "Batalkan Pesanan",
        "description": "Membatalkan pesanan pending dan mengembalikan kuota tiket secara otomatis.",
        "tags": ["Checkout"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_id"],
                "properties": {
                  "order_id": { "type": "integer", "example": 102 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pesanan berhasil dibatalkan dan stok dikembalikan." }
        }
      }
    },
    "/api/orders": {
      "get": {
        "summary": "Riwayat Transaksi Pengguna (UU PDP Masked)",
        "description": "Mengambil riwayat transaksi milik user login dengan penyamaran data sensitif (PII Masking).",
        "tags": ["Orders"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Riwayat transaksi berhasil diambil." }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Detail Transaksi & E-Tiket",
        "description": "Mengambil detail pesanan, rincian kursi, data attendee, dan barcode e-tiket unik.",
        "tags": ["Orders"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detail pesanan berhasil diambil." },
          "404": { "description": "Pesanan tidak ditemukan." }
        }
      }
    },
    "/api/vouchers/active": {
      "get": {
        "summary": "Daftar Voucher Promo Aktif",
        "description": "Mengambil daftar promo voucher publik yang sedang aktif beserta syarat minimum belanja dan maksimal diskon.",
        "tags": ["Vouchers"],
        "responses": {
          "200": { "description": "Daftar voucher promo aktif berhasil diambil." }
        }
      }
    },
    "/api/vouchers/apply": {
      "post": {
        "summary": "Validasi & Cek Diskon Voucher",
        "description": "Mengecek keabsahan kode voucher terhadap subtotal belanja dan menghitung potongan harga.",
        "tags": ["Vouchers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "subtotal"],
                "properties": {
                  "code": { "type": "string", "example": "TIKETLYHEMAT20" },
                  "subtotal": { "type": "integer", "example": 200000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Voucher valid dan diskon berhasil dihitung." },
          "400": { "description": "Voucher tidak valid / kuota habis / syarat tidak terpenuhi." }
        }
      }
    },
    "/api/scanner/validate": {
      "post": {
        "summary": "Gate Scanner: Preview Validasi Tiket",
        "description": "Memeriksa status tiket, nama penonton, dan keabsahan QR code tanpa mengubah status check-in.",
        "tags": ["Scanner"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticket_code"],
                "properties": {
                  "ticket_code": { "type": "string", "example": "TKT-E02-54-5D3A44" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tiket valid dan siap check-in." },
          "400": { "description": "Status pesanan belum lunas." },
          "404": { "description": "Tiket tidak ditemukan." }
        }
      }
    },
    "/api/scanner/checkin": {
      "post": {
        "summary": "Gate Scanner: Eksekusi Check-in (Anti-Double Scan Protection)",
        "description": "Melakukan check-in tiket penonton secara atomic. Jika tiket sudah pernah di-scan sebelumnya, sistem otomatis menolak dengan kode 409 Conflict.",
        "tags": ["Scanner"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ticket_code"],
                "properties": {
                  "ticket_code": { "type": "string", "example": "TKT-E02-54-5D3A44" },
                  "gate": { "type": "string", "example": "Gate VIP Barat" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Check-in berhasil. Penonton diizinkan masuk." },
          "409": { "description": "PERINGATAN: Tiket ganda terdeteksi (sudah pernah di-check-in sebelumnya)." },
          "404": { "description": "Tiket tidak ditemukan." }
        }
      }
    },
    "/api/scanner/stats/{eventId}": {
      "get": {
        "summary": "Gate Scanner: Real-time Gate Statistics",
        "description": "Mengambil statistik langsung kehadiran penonton di gate (Total tiket terjual, penonton yang sudah masuk, penonton di luar, dan persentase).",
        "tags": ["Scanner"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "integer", "example": 2 } }
        ],
        "responses": {
          "200": { "description": "Statistik kehadiran gate berhasil diambil." },
          "404": { "description": "Event tidak ditemukan." }
        }
      }
    },
    "/api/payment/webhook": {
      "post": {
        "summary": "Midtrans Payment Webhook Handler",
        "description": "Menerima notifikasi status pembayaran dari Midtrans dengan verifikasi SHA512 signature, update pesanan idempotent, dan pengiriman otomatis e-tiket.",
        "tags": ["Payment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_id", "status_code", "gross_amount", "signature_key", "transaction_status"],
                "properties": {
                  "order_id": { "type": "string", "example": "TRX-20260827-ABC12345" },
                  "status_code": { "type": "string", "example": "200" },
                  "gross_amount": { "type": "string", "example": "250000.00" },
                  "signature_key": { "type": "string", "example": "9a8b7c6d5e4f..." },
                  "transaction_status": { "type": "string", "example": "settlement" },
                  "fraud_status": { "type": "string", "example": "accept" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Webhook berhasil diproses." },
          "403": { "description": "Signature key Midtrans tidak valid." }
        }
      }
    },
    "/api/terms": {
      "get": {
        "summary": "Syarat & Ketentuan (Terms & Conditions)",
        "description": "Mengambil dokumen syarat dan ketentuan resmi penggunaan platform Ticketly dalam format JSON.",
        "tags": ["Legal"],
        "responses": {
          "200": { "description": "Syarat & Ketentuan berhasil diambil." }
        }
      }
    },
    "/api/privacy": {
      "get": {
        "summary": "Kebijakan Privasi (Privacy Policy - UU PDP)",
        "description": "Mengambil dokumen kebijakan privasi dan perlindungan data pribadi pengguna sesuai UU PDP.",
        "tags": ["Legal"],
        "responses": {
          "200": { "description": "Kebijakan privasi berhasil diambil." }
        }
      }
    }
  }
}
